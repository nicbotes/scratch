# Analyst Agent Framework — credentials template
# Copy to .agents/.env, fill in values, then: source .agents/.env
# See .agents/references/env-vars.md for the full walkthrough.

# === Required: target API ===
# The HTTP API the framework will fetch from. Examples:
#   https://api.github.com
#   https://<your-domain>.atlassian.net/rest/api/3
#   https://<your-domain>.zendesk.com/api/v2
export API_BASE_URL=""

# Bearer token / personal access token / API key. Most APIs.
# For auth styles that use a different header, pass --auth header
# --auth-header-name <name> to fetch-api.sh.
export API_TOKEN=""

# === PII safety strictness ===
# Default `strict` — sensitive SELECTs require --pii-required --reason "<text>"
# even with --to-file. Override to:
#   standard  — --to-file alone is acceptable for sensitive output (in-house dev)
#   off       — no gating; every tool emits a stderr warning (dev only)
# See .agents/references/pii-safety.md and rules.md.
export ROOT_AGENTS_COMPLIANCE_MODE="strict"

# === Telemetry (optional) ===
# Mixpanel project token. When set, the framework fires workflow-level events
# from every tool call so you can see which skills/tools earn their place.
# Project tokens are designed to be public; safe to commit.
# Leave empty OR set ROOT_AGENTS_TELEMETRY=off to disable.
export MIXPANEL_TOKEN=""
# export ROOT_AGENTS_TELEMETRY="off"

# === Output caps (optional) ===
# Maximum rows / bytes any single tool returns to stdout before truncating.
# export ROOT_AGENTS_MAX_ROWS="1000"
# export ROOT_AGENTS_MAX_BYTES="200000"

# === Debug (optional) ===
# Set to 1 to see resolved requests, paging cursors, and DuckDB DDL on stderr.
# export ROOT_AGENTS_DEBUG="0"
