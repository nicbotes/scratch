# Root Data Adapter — credentials template
# Copy to .agents/.env (or repo root .env), fill in values, then:
#   source .agents/.env
#
# Get all values from: Root Dashboard → Data Management → Data Adapter → Generate Access Key
# See .agents/references/env-vars.md for full walkthrough.

export AWS_ACCESS_KEY_ID="AKIA..."
export AWS_SECRET_ACCESS_KEY="..."

# AWS_REGION is auto-detected from ROOT_ATHENA_S3_BUCKET on first tool call.
# Uncomment only if you need to override (e.g. cross-region replica).
# export AWS_REGION="eu-west-1"

# Athena Schema = Workgroup = S3 prefix — all three dashboard fields are the same value
export ROOT_ORG_ID="<org-id>"

# Bucket name only — strip s3:// and the trailing <org-id>/ from "S3 Output Location"
export ROOT_ATHENA_S3_BUCKET="<bucket-name>"

# Optional — defaults to "production". Set to "sandbox" to query sandbox data.
# export ROOT_ENV="production"

# PII safety strictness. Default is `strict` — sensitive SELECTs require
# --pii-required --reason "<text>" even with --to-file. Override to:
#   standard  — --to-file alone is acceptable for sensitive output (in-house dev)
#   off       — no gating; every tool emits a stderr warning (dev only)
# See .agents/references/pii-safety.md and rules.md #26-#28.
export ROOT_AGENTS_COMPLIANCE_MODE="strict"

# Mixpanel telemetry (EU project). Eleven workflow-level events fire when
# this token is set: Exploration Started, BI Work Started, Ops Work Started,
# Scope Clarified, View Saved, Local Processing Started, PII Approved,
# PII Touched, Evidence Captured, Feedback Noted, Skill Learned.
# Project tokens are designed to be public; safe to commit.
# To disable, leave unset OR set ROOT_AGENTS_TELEMETRY=off.
export MIXPANEL_TOKEN=""
# export ROOT_AGENTS_TELEMETRY="off"
